# Zephyr 光影选项 / 简体中文（zh_CN）
# 选项名对应 shaders/lib/settings.glsl 中的 GLSL 宏。
# option.<宏>=名称   option.<宏>.comment=悬停说明
# value.<宏>.<n>=取值标签   screen.<页>=页面标题
# screen.<页>.comment=页面说明   profile.<档位>=档位名称

# ---- 性能档位 ----
profile.LOW=低
profile.MEDIUM=中
profile.HIGH=高（默认）
profile.ULTRA=极致
profile.comment=档位会同时调整 TAA、环境光遮蔽、反射、体积光、阴影分辨率与泛光。应用后每个选项仍可单独调整。

# ---- 页面 ----
screen.quality=画质与性能
screen.quality.comment=功能开关、阴影分辨率与 TAA 历史权重。
screen.lighting=光照与阴影
screen.lighting.comment=太阳/天空平衡、彩色阴影与动态手持光。
screen.sky=天空与大气
screen.sky.comment=程序化夜空、星星、月亮、云层与大气密度。
screen.post=泛光与色彩
screen.post.comment=泛光强度、光晕范围、曝光与最终调色。
screen.material=材质与动画
screen.material.comment=玻璃染色、植被摇曳与表面起伏。
screen.weather=天气
screen.weather.comment=水洼、雨雾、雷雨云与闪电。

# ---- 画质与性能 ----
option.TAA_ENABLED=时间抗锯齿（TAA）
option.TAA_ENABLED.comment=投影抖动配合历史帧混合，减少植被闪烁与锯齿。
value.TAA_ENABLED.0=关
value.TAA_ENABLED.1=开
option.AO_ENABLED=环境光遮蔽
option.AO_ENABLED.comment=屏幕空间的角落与缝隙接触变暗。
value.AO_ENABLED.0=关
value.AO_ENABLED.1=开
option.SSR_ENABLED=屏幕空间反射
option.SSR_ENABLED.comment=湿滑路面与水面的屏幕空间反射。
value.SSR_ENABLED.0=关
value.SSR_ENABLED.1=开
option.VL_ENABLED=体积光
option.VL_ENABLED.comment=来自太阳盘的丁达尔光 / 光轴。
value.VL_ENABLED.0=关
value.VL_ENABLED.1=开
option.SHADOW_ENABLED=阴影
option.SHADOW_ENABLED.comment=PCF 太阳阴影，含半透明与彩色投影体。
value.SHADOW_ENABLED.0=关
value.SHADOW_ENABLED.1=开
option.CLOUD_ENABLED=云层
option.CLOUD_ENABLED.comment=光线步进的云层。
value.CLOUD_ENABLED.0=关
value.CLOUD_ENABLED.1=开
option.PUDDLE_ENABLED=雨中水洼
option.PUDDLE_ENABLED.comment=雨天的湿滑表面遮罩与水洼反射。
value.PUDDLE_ENABLED.0=关
value.PUDDLE_ENABLED.1=开
option.LIGHTNING_ENABLED=闪电
option.LIGHTNING_ENABLED.comment=雷雨时的全局照明闪光。
value.LIGHTNING_ENABLED.0=关
value.LIGHTNING_ENABLED.1=开
option.shadowMapResolution=阴影分辨率
option.shadowMapResolution.comment=注意：本机 Iris 版本下 F3 实测始终为 1024×1024，此项可能不生效。
option.shadowDistance=阴影距离
option.TAA_MIN_BLEND=TAA 最小混合量
option.TAA_MIN_BLEND.comment=历史拒绝的下限；数值越高越稳，但画面更软。

# ---- 光照与阴影 ----
option.HAND_LIGHT_ENABLED=动态手持光
option.HAND_LIGHT_ENABLED.comment=手持火把、灯笼、海晶灯时跟随相机的点光源。
value.HAND_LIGHT_ENABLED.0=关
value.HAND_LIGHT_ENABLED.1=开
option.HAND_LIGHT_INTENSITY=手持光强度
option.EMISSIVE_HDR_CAP=发光体 HDR 上限
option.EMISSIVE_HDR_CAP.comment=限制光源亮度，避免放置的海晶灯产生过大的光晕。
option.LIGHT_SUN_INTENSITY=太阳强度
option.LIGHT_SKY_INTENSITY=天空环境光强度
option.SHADOW_COLOR_STRENGTH=彩色阴影
option.SHADOW_COLOR_STRENGTH.comment=染色玻璃对透过光线的染色程度。
option.SHADOW_SOFTNESS=阴影柔和度
option.NIGHT_AMBIENT_FLOOR=夜间环境光下限

# ---- 天空与大气 ----
option.NIGHT_SKY_ENABLED=夜空
option.NIGHT_SKY_ENABLED.comment=程序化深蓝渐变天空、星星与带月相的月亮。
value.NIGHT_SKY_ENABLED.0=关
value.NIGHT_SKY_ENABLED.1=开
option.NIGHT_SKY_STRENGTH=夜空亮度
option.STAR_BRIGHTNESS=星星亮度
option.MOON_BRIGHTNESS=月亮亮度
option.MOON_HALO_STRENGTH=月晕
option.CLOUD_COVERAGE=云量
option.CLOUD_DENSITY=云层密度
option.ATMOSPHERE_DENSITY=大气密度

# ---- 泛光与色彩 ----
option.BLOOM_STRENGTH=泛光强度
option.BLOOM_STRENGTH.comment=色调映射前作用于线性 HDR 的软膝泛光。
option.BLOOM_HALO_STRENGTH=宽光晕强度
option.BLOOM_HALO_STRENGTH.comment=独立于紧致泛光的高 mip 光晕圈，作用于所有光源。
option.BLOOM_THRESHOLD=泛光阈值
option.GRADE_SATURATION=饱和度
option.GRADE_CONTRAST=对比度
option.EXPOSURE_EV=曝光（EV）
option.TONEMAP_MODE=色调映射
option.TONEMAP_MODE.comment=ACES 为基线；AgX 为亮度域的电影感变换。
value.TONEMAP_MODE.0=ACES
value.TONEMAP_MODE.1=AgX
option.TAA_JITTER_SCALE=TAA 抖动幅度

# ---- 材质与动画 ----
option.GLASS_ABSORPTION=玻璃吸收率
option.TRANSLUCENT_TINT_STRENGTH=玻璃染色强度
option.GLASS_NEUTRAL_VEIL=磨砂玻璃面
option.GLASS_NEUTRAL_VEIL.comment=让白 / 黑 / 遮光玻璃看得出来，同时不遮住背后的景物。
option.GLASS_EDGE_STRENGTH=玻璃边缘高光
option.WAVE_ENABLED=植被摇曳
option.WAVE_ENABLED.comment=草、花与树叶的动画，与阴影 pass 共用同一位移模板。
value.WAVE_ENABLED.0=关
value.WAVE_ENABLED.1=开
option.WAVE_AMPLITUDE=摇曳幅度
option.WAVE_RAIN_BOOST=雨天摇曳增强
option.LEAF_SSS_ENABLED=叶片次表面散射
option.LEAF_SSS_ENABLED.comment=薄叶片透射：逆光的叶片会透出叶绿素调制的黄绿光，而不是平板的白光。
value.LEAF_SSS_ENABLED.0=关
value.LEAF_SSS_ENABLED.1=开
option.LEAF_TRANSMISSION=叶片透射强度
option.LEAF_TRANSMISSION.comment=穿过叶片朝观察者散射的光线强度。
option.LEAF_VITALITY=植被绿意
option.LEAF_VITALITY.comment=在保持亮度不变的前提下提升叶片的绿色鲜艳度；数值越高越葱郁。
option.POM_ENABLED=表面起伏
option.POM_ENABLED.comment=UV 空间凹凸扰动（完整视差位移目前默认关闭）。
value.POM_ENABLED.0=关
value.POM_ENABLED.1=开

# ---- 天气 ----
option.PUDDLE_STRENGTH=水洼强度
option.PUDDLE_RIPPLE=水洼涟漪
option.RAIN_BLOOM_BOOST=雨天泛光增强
option.LIGHTNING_INTENSITY=闪电强度
option.STORM_CLOUD_COVERAGE=雷雨云量
option.RAIN_FOG_DIST_POW=雨雾衰减
option.FOG_DENSITY=雾浓度

# ---- 水体体积（M31）----
screen.water=水体体积
screen.water.comment=按波长的吸收、水下雾与悬浮微粒。
option.WATER_VOLUME_ENABLED=水体体积渲染
option.WATER_VOLUME_ENABLED.comment=Beer-Lambert 波长吸收：红光先被吸收，越深越偏青绿。
value.WATER_VOLUME_ENABLED.0=关
value.WATER_VOLUME_ENABLED.1=开
option.WATER_FOG_DENSITY=水下雾密度
option.WATER_FOG_DENSITY.comment=每米的水下消光系数；数值越高，水下可见距离越短。
option.WATER_PARTICLE_ENABLED=水下悬浮粒子
option.WATER_PARTICLE_ENABLED.comment=世界空间中缓慢漂移的微粒，与水下体积共衰减。
value.WATER_PARTICLE_ENABLED.0=关
value.WATER_PARTICLE_ENABLED.1=开
option.WATER_PARTICLE_DENSITY=粒子密度
option.WATER_PARTICLE_DENSITY.comment=世界空间网格中生成可见微粒的格子比例。
option.WATER_PARTICLE_BRIGHTNESS=粒子亮度
option.WATER_PARTICLE_BRIGHTNESS.comment=粒子与水下雾共用同一套 Beer-Lambert 透射率衰减。

# ---- 焦散、水下体积光、夜间荧光（M33）----
option.CAUSTICS_ENABLED=水体焦散
option.CAUSTICS_ENABLED.comment=投射到水下几何上的动态亮纹，需要日光。
value.CAUSTICS_ENABLED.0=关
value.CAUSTICS_ENABLED.1=开
option.CAUSTICS_STRENGTH=焦散强度
option.CAUSTICS_STRENGTH.comment=水底与水下物体上聚焦光纹的强度。
option.WATER_VL_ENABLED=水下体积光
option.WATER_VL_ENABLED.comment=阳光被水体散射形成的可见光束。
value.WATER_VL_ENABLED.0=关
value.WATER_VL_ENABLED.1=开
option.WATER_VL_STRENGTH=体积光强度
option.WATER_VL_STRENGTH.comment=水下阳光光束的亮度。
option.WATER_PARTICLE_NIGHT_BOOST=粒子夜间荧光
option.WATER_PARTICLE_NIGHT_BOOST.comment=夜晚悬浮粒子会呈现淡淡的青绿生物荧光。

# ---- 视差 / POM（M34）----
option.POM_ENABLED=表面视差
option.POM_ENABLED.comment=UV 空间起伏。完整视差位移仍默认关闭（POM_DEPTH = 0）。
value.POM_ENABLED.0=关
value.POM_ENABLED.1=开
option.POM_DEPTH=视差深度
option.POM_DEPTH.comment=UV 位移深度。为 0 时仅保留凹凸光照；调高时留意掠射角畸变。
option.POM_BUMP=表面凹凸强度
option.POM_BUMP.comment=由高度纹理推导的法线扰动强度。
# ---- 材质相关次表面散射（M34）----
option.GLASS_SSS_ENABLED=玻璃次表面散射
option.GLASS_SSS_ENABLED.comment=逆光的玻璃会按自身透射色散射光线；无色玻璃只保留微弱的中性辉光。
value.GLASS_SSS_ENABLED.0=关
value.GLASS_SSS_ENABLED.1=开
option.GLASS_SSS_STRENGTH=玻璃散射强度
option.GLASS_SSS_STRENGTH.comment=逆光玻璃辉光强度。树叶使用各自的叶绿素色，不受此项影响。

# ---- 水面真实感（M35）----
option.WATER_WAVE_ENABLED=程序化水面波纹
option.WATER_WAVE_ENABLED.comment=用非周期的多层波浪法线替代规则的正弦网格。
value.WATER_WAVE_ENABLED.0=关
value.WATER_WAVE_ENABLED.1=开
option.WATER_SSS_ENABLED=水体次表面散射
option.WATER_SSS_ENABLED.comment=阳光在水体内部散射，掠射方向会透出青绿光。
value.WATER_SSS_ENABLED.0=关
value.WATER_SSS_ENABLED.1=开
option.WATER_SSS_STRENGTH=水体散射强度
option.WATER_SSS_STRENGTH.comment=水体内部次表面辉光的强度。
option.WATER_GLITTER_ENABLED=波纹太阳闪光
option.WATER_GLITTER_ENABLED.comment=随波纹法线分布的细碎镜面闪光。
value.WATER_GLITTER_ENABLED.0=关
value.WATER_GLITTER_ENABLED.1=开
option.WATER_GLITTER_STRENGTH=闪光强度
option.WATER_GLITTER_STRENGTH.comment=波纹闪光的亮度。

# ---- 水体近远层次与岸上焦散（M61）----
option.WATER_DEEP_SCATTER=深水散射色
option.WATER_DEEP_SCATTER.comment=水体色由中性浅水色转向深青蓝的程度；0 为中性。
option.WATER_NEAR_SAT=近场去饱和
option.WATER_NEAR_SAT.comment=近处水底保留多少饱和度；数值越低，近处越接近中性浅色。
option.WATER_NEAR_GAIN=近场提亮
option.WATER_NEAR_GAIN.comment=短水程处的亮度增益，用来形成近浅远深的层次。
option.CAUSTICS_ABOVE_GAIN=岸上焦散
option.CAUSTICS_ABOVE_GAIN.comment=从水面之上观察时，投射到水下几何上的焦散强度；0 关闭。
option.WATER_REFL_PATH_FADE=远场反射让位
option.WATER_REFL_PATH_FADE.comment=水程越长，水面倒影让位给水体体积的比例；0 关闭。

# ---- 水体体积（参考 iterationT，M40）----
option.WATER_BODY_ENABLED=水体体积渲染
option.WATER_BODY_ENABLED.comment=水面上方视角下的按波长吸收、波纹折射与浅水提亮。
value.WATER_BODY_ENABLED.0=关
value.WATER_BODY_ENABLED.1=开
option.WATER_ATTEN_RATE=水体吸收速率
option.WATER_ATTEN_RATE.comment=红光随水深被吸收的速度；数值越高，深水越早转蓝。
option.WATER_SCATTER_RATE=水体散射速率
option.WATER_SCATTER_RATE.comment=远处水体融入自身散射色的速度。
option.WATER_BOTTOM_MIX=水底可见度
option.WATER_BOTTOM_MIX.comment=从 gbuffer 恢复的水底纹理替代平面水色的比例。
option.WATER_REFRACT_STRENGTH=波纹折射
option.WATER_REFRACT_STRENGTH.comment=水波造成的屏幕空间 UV 扰动强度。
option.WATER_BODY_MIX=水体混合
option.WATER_BODY_MIX.comment=原始水面着色与体积水体之间的混合比例。
option.WATER_BOTTOM_LIGHT=水底光照
option.WATER_BOTTOM_LIGHT.comment=恢复出的水底纹理所受的光照强度。
option.WATER_REFL_ENABLED=水面环境反射
option.WATER_REFL_ENABLED.comment=在水面映出天空、云与周围景物，波纹会把倒影打碎成流动的条带。
value.WATER_REFL_ENABLED.0=关
value.WATER_REFL_ENABLED.1=开
option.WATER_REFL_GAIN=反射强度
option.WATER_REFL_GAIN.comment=水面反射的整体强度。
option.WATER_REFL_ENV_MIX=景物倒影
option.WATER_REFL_ENV_MIX.comment=倒影中来自周围景物的比例，其余为解析天空。
option.WATER_REFL_NEAR_KEEP=近处透视保留
option.WATER_REFL_NEAR_KEEP.comment=近处保留多少反射；数值越低越能透出水底。
option.WATER_REFL_CLOUD=云影反射
option.WATER_REFL_CLOUD.comment=水面映出的云层亮度。
option.WATER_SSR_MIX=屏幕空间反射
option.WATER_SSR_MIX.comment=倒影中来自真实屏幕空间射线追踪的比例，其余为天空近似。
